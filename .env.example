# Database
DATABASE_URL=postgresql://localhost/apsara

# Auth.js
AUTH_SECRET=               # Run: npx auth secret
AUTH_GOOGLE_ID=            # Google OAuth Client ID
AUTH_GOOGLE_SECRET=        # Google OAuth Client Secret
AUTH_TRUST_HOST=true

# Razorpay
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_key_secret
PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# App
SUPER_ADMIN_EMAIL=you@example.com
UPLOAD_DIR=./uploads
MEDIA_BASE_URL=http://localhost:5173/api/media

# Storage Provider: 'local' (default) or 's3'
# STORAGE_PROVIDER=local

# S3-Compatible Storage (Cloudflare R2, AWS S3, MinIO, etc.)
# Required when STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# S3_BUCKET=your-bucket-name

# Optional: Public URL for direct access (e.g. R2 custom domain or CDN)
# When set, media URLs point directly here instead of going through /api/media
# S3_PUBLIC_URL=https://media.yourdomain.com

# Optional: Presigned URL expiry in seconds (default: 3600)
# Only used when S3_PUBLIC_URL is not set
# S3_PRESIGNED_URL_EXPIRY=3600

# Production only
# ORIGIN=https://yourdomain.com
